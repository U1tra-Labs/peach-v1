# Copy to .env and fill in. Never commit real keys.
# Mainnet-beta RPC (use a private RPC for production keepers).
RPC_URL=https://api.mainnet-beta.solana.com
ANCHOR_PROVIDER_URL=https://api.mainnet-beta.solana.com
ANCHOR_WALLET=~/.config/solana/id.json
KEEPER_KEYPAIR=~/.config/solana/id.json

# Hermes (API key required since the Aug-2026 Pyth Core upgrade).
# Either endpoint works; keep the one matching your key issuer.
HERMES_URL=https://hermes.pyth.network
# HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=

# Keeper behavior. Shard must match token_register + clients.
PYTH_SHARD_ID=0
PYTH_FEEDS=SOL/USD,USDC/USD
KEEPER_INTERVAL_MS=10000
COMPUTE_UNIT_PRICE=50000
